rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameKey(key) {
      return key is string && key.size() >= 1 && key.size() <= 4 && key.matches('^[a-z0-9_]+$');
    }

    function isValidUsernameDisplay(name) {
      return name is string && name.size() >= 1 && name.size() <= 4 && name.matches('^[a-zA-Z0-9_]+$');
    }

    function isValidAuthorLabel(label) {
      return label is string && label.size() >= 1 && label.size() <= 32;
    }

    function isValidReactionEmoji(emoji) {
      return emoji in ['FIRE', 'LOVE', 'VIBE', 'CLAP', 'SAD'];
    }

    function isValidUsernameClaim(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidUsernameDisplay(data.username) &&
             isValidUsernameKey(data.usernameKey) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidUserAccount(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidUsernameDisplay(data.username) &&
             isValidUsernameKey(data.usernameKey) &&
             (!('driveFileId' in data) || data.driveFileId == null || (data.driveFileId is string && data.driveFileId.size() <= 256)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDiagnosticLog(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidId(data.reportId) &&
             data.isFatal is bool &&
             data.tag is string &&
             data.tag.size() >= 1 &&
             data.tag.size() <= 64 &&
             data.errorType is string &&
             data.errorType.size() >= 1 &&
             data.errorType.size() <= 160 &&
             data.message is string &&
             data.message.size() <= 1000 &&
             data.stackTrace is string &&
             data.stackTrace.size() <= 6000 &&
             data.deviceInfo is string &&
             data.deviceInfo.size() >= 1 &&
             data.deviceInfo.size() <= 300 &&
             data.appVersion is string &&
             data.appVersion.size() >= 1 &&
             data.appVersion.size() <= 64 &&
             data.firebaseConfigured is bool &&
             data.timestampMs is int &&
             data.timestampMs >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidFavoriteTrack(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidId(data.favoriteId) &&
             data.trackId is string &&
             data.trackId.size() >= 1 &&
             data.trackId.size() <= 512 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.artist is string &&
             data.artist.size() >= 1 &&
             data.artist.size() <= 200 &&
             data.album is string &&
             data.album.size() <= 200 &&
             data.durationMs is int &&
             data.durationMs >= 0 &&
             data.mediaUri is string &&
             data.mediaUri.size() <= 2048 &&
             data.artworkUri is string &&
             data.artworkUri.size() <= 2048 &&
             data.importedTrack is bool &&
             data.onlineTrack is bool &&
             data.remixTrack is bool &&
             data.instaTrend is bool &&
             data.fullTrack is bool &&
             data.addedAtMs is int &&
             data.addedAtMs >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTrackReaction(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidId(data.trackKey) &&
             data.trackTitle is string &&
             data.trackTitle.size() >= 1 &&
             data.trackTitle.size() <= 300 &&
             isValidReactionEmoji(data.emojiType) &&
             isValidAuthorLabel(data.authorUsername) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTrackComment(data) {
      return isValidId(data.commentId) &&
             isValidId(data.trackKey) &&
             data.trackTitle is string &&
             data.trackTitle.size() >= 1 &&
             data.trackTitle.size() <= 300 &&
             data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidAuthorLabel(data.authorUsername) &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 500 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /usernames/{usernameKey} {
      allow get: if isSignedIn() && isValidUsernameKey(usernameKey);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidUsernameKey(usernameKey) &&
                       isValidUsernameClaim(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().usernameKey == usernameKey &&
                       incoming().keys().hasAll(['userId', 'username', 'usernameKey', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'usernameKey', 'createdAt']) &&
                       !exists(/databases/$(database)/documents/usernames/$(usernameKey));

      allow update: if false;
      allow delete: if isSignedIn() && isValidUsernameKey(usernameKey) && existing().userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'usernameKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'usernameKey', 'driveFileId', 'createdAt', 'updatedAt']) &&
                       existsAfter(/databases/$(database)/documents/usernames/$(incoming().usernameKey));

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().username == existing().username &&
                       incoming().usernameKey == existing().usernameKey &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['driveFileId', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /diagnosticLogs/{logId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(logId) &&
                         request.auth.uid == userId &&
                         isValidDiagnosticLog(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().reportId == logId &&
                         incoming().keys().hasAll([
                           'userId', 'reportId', 'isFatal', 'tag', 'errorType',
                           'message', 'stackTrace', 'deviceInfo', 'appVersion',
                           'firebaseConfigured', 'timestampMs', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'reportId', 'isFatal', 'tag', 'errorType',
                           'message', 'stackTrace', 'deviceInfo', 'appVersion',
                           'firebaseConfigured', 'timestampMs', 'createdAt'
                         ]);

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
      }

      match /favorites/{favoriteId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         request.auth.uid == userId &&
                         isValidFavoriteTrack(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().favoriteId == favoriteId &&
                         incoming().keys().hasAll([
                           'userId', 'favoriteId', 'trackId', 'title', 'artist', 'album',
                           'durationMs', 'mediaUri', 'artworkUri',
                           'importedTrack', 'onlineTrack', 'remixTrack', 'instaTrend', 'fullTrack',
                           'addedAtMs', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'favoriteId', 'trackId', 'title', 'artist', 'album',
                           'durationMs', 'mediaUri', 'artworkUri',
                           'importedTrack', 'onlineTrack', 'remixTrack', 'instaTrend', 'fullTrack',
                           'addedAtMs', 'createdAt', 'updatedAt'
                         ]);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         request.auth.uid == userId &&
                         isValidFavoriteTrack(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().favoriteId == existing().favoriteId &&
                         incoming().trackId == existing().trackId &&
                         incoming().addedAtMs == existing().addedAtMs &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'favoriteId', 'trackId', 'title', 'artist', 'album',
                           'durationMs', 'mediaUri', 'artworkUri',
                           'importedTrack', 'onlineTrack', 'remixTrack', 'instaTrend', 'fullTrack',
                           'addedAtMs', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'artist', 'album', 'durationMs', 'mediaUri', 'artworkUri',
                           'importedTrack', 'onlineTrack', 'remixTrack', 'instaTrend', 'fullTrack',
                           'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && request.auth.uid == userId;
      }
    }

    match /tracks/{trackKey} {
      allow read, write: if false;

      match /reactions/{userId} {
        allow get, list: if isSignedIn() && isValidId(trackKey);

        allow create: if isSignedIn() &&
                         isValidId(trackKey) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         isValidTrackReaction(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().trackKey == trackKey &&
                         incoming().keys().hasAll([
                           'userId', 'trackKey', 'trackTitle', 'emojiType',
                           'authorUsername', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'trackKey', 'trackTitle', 'emojiType',
                           'authorUsername', 'createdAt', 'updatedAt'
                         ]);

        allow update: if isSignedIn() &&
                         isValidId(trackKey) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         isValidTrackReaction(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().trackKey == existing().trackKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'trackKey', 'trackTitle', 'emojiType',
                           'authorUsername', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'emojiType', 'authorUsername', 'trackTitle', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(trackKey) &&
                         isValidId(userId) &&
                         request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow get, list: if isSignedIn() && isValidId(trackKey);

        allow create: if isSignedIn() &&
                         isValidId(trackKey) &&
                         isValidId(commentId) &&
                         isValidTrackComment(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().trackKey == trackKey &&
                         incoming().commentId == commentId &&
                         incoming().keys().hasAll([
                           'commentId', 'trackKey', 'trackTitle', 'userId',
                           'authorUsername', 'text', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'commentId', 'trackKey', 'trackTitle', 'userId',
                           'authorUsername', 'text', 'createdAt', 'updatedAt'
                         ]);

        allow update: if isSignedIn() &&
                         isValidId(trackKey) &&
                         isValidId(commentId) &&
                         existing().userId == request.auth.uid &&
                         isValidTrackComment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().commentId == existing().commentId &&
                         incoming().trackKey == existing().trackKey &&
                         incoming().authorUsername == existing().authorUsername &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'commentId', 'trackKey', 'trackTitle', 'userId',
                           'authorUsername', 'text', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'text', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(trackKey) &&
                         isValidId(commentId) &&
                         existing().userId == request.auth.uid;
      }
    }
  }
}
